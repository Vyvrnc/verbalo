<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only for the one-time NPU model download from Qualcomm (Settings); audio never leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Floating dictation button: overlay window + microphone foreground service. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionListener" />
        </intent>
        <!--    Only android.speech.RecognitionListener should be enough in theory, but for some reason, some apps need android
        .intent.action.MAIN-->
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:memtagMode="async"
        android:supportsRtl="true"
        tools:targetApi="34">
        <!-- FastRPC client from the vendor partition; apps targeting S+ must declare it, otherwise
             the linker namespace hides it and QNN cannot load its DSP stub. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <service
            android:name=".recognitionservice.MainRecognitionService"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:label="Transcribro NPU – rozpoznávání řeči"
            android:permission="android.permission.RECORD_AUDIO">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>
        <service
            android:name=".ui.voiceinput.VoiceInput"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

        <service
            android:name="cz.vyvrnc.transcribronpu.floating.FloatingDictationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name="cz.vyvrnc.transcribronpu.floating.TextInsertionService"
            android:exported="false"
            android:label="@string/text_insertion_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/text_insertion_service" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Transcribro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.action_recognize_speech.ActionRecognizeSpeechActivity"
            android:exported="true"
            android:theme="@style/Theme.FloatingWindow">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>